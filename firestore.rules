rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these Google / email accounts can read or write anything.
    // Replace the email below with yours (add teammates the same way).
    function allowed() {
      return request.auth != null
        && request.auth.token.email in ['you@example.com'];
    }
    match /leads/{id} {
      allow read, write: if allowed();
    }
    match /settings/{id} {
      allow read, write: if allowed();
    }
    // Card photos (kept separately so the card list stays fast)
    match /photos/{id} {
      allow read, write: if allowed();
    }
    // Error log (Settings → Error log)
    match /logs/{id} {
      allow read, write: if allowed();
    }
  }
}
