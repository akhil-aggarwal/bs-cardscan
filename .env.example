# --- Firebase (Project settings > General > Your apps > Web app config) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Gemini (https://aistudio.google.com/apikey) — keep secret, server only ---
GEMINI_API_KEY=
# Optional: change the model without touching code
GEMINI_MODEL=gemini-3.5-flash

# --- Who may use the card reader (comma separated, same emails as firestore.rules) ---
ALLOWED_EMAILS=you@example.com
